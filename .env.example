POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://roster:change-me@localhost:5432/roster
APP_ENV=development

# Leave these empty while using the local simulator. Never commit real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
# Optional approved template for proactive invitations outside the 24-hour window.
# Body parameters: invitation id, date, time, role, justification; buttons ACEITAR/RECUSAR.
WHATSAPP_INVITE_TEMPLATE=
# Separate approved template with one body text parameter for coordinator notifications.
WHATSAPP_NOTIFICATION_TEMPLATE=
# Normal automation invitation: one body text parameter and two quick reply buttons.
# Payloads: ACEITAR A<id> and RECUSAR A<id>. Requires a separately approved Meta template.
WHATSAPP_AUTOMATION_TEMPLATE=
# Approved reminder template: one body text parameter, no quick replies.
WHATSAPP_REMINDER_TEMPLATE=
AUTOMATION_INVITE_TTL_HOURS=48
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
CONVERSATION_TTL_MINUTES=30
WEBHOOK_MAX_BYTES=262144
WEBHOOK_MAX_EVENTS=1000
WEBHOOK_READ_TIMEOUT_SECONDS=5
INBOUND_LIMIT_PER_MINUTE=30
HEALTH_READY_TIMEOUT_SECONDS=2
